+    // fragment writes, leaving every presented frame black.
+    if (!g_state.simple[gpu::kMColorWriteEnable >> 2])
+        g_state.simple[gpu::kMColorWriteEnable >> 2] = 0x01010101;
     LOG_FIRST(1, "d3d: image has no D3D_InitDefaultState; applied unset texture-stage defaults");
 #endif
 }
