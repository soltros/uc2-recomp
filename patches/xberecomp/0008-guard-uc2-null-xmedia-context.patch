+
+// UC2's packet helper is also called with a null optional pvContext.
+// Preserve the XDK implementation for non-null contexts; skip only the
+// unavailable notification path when its callback context is absent.
+X86_EXTERN_FUNC(GUEST_ORIG(DSOUND_Internal_XMediaPacketNotify));
+X86_FUNC(GUEST(DSOUND_Internal_XMediaPacketNotify)) {
+    const uint32_t packet = ::kernel::R32(ctx.esp + 4);
+    if (!packet || !::kernel::R32(packet + 0x10)) {
+        ::kernel::Return(ctx, 0, 2);
+        return;
+    }
+    GUEST_ORIG(DSOUND_Internal_XMediaPacketNotify)(ctx, base);
+}
+
+// XDK packet processing assumes its callback object is valid. A null optional
+// context cannot pass the callback's flag check, so return INVALIDCALL.
+X86_EXTERN_FUNC(GUEST_ORIG(DSOUND_Internal_XMediaPacketUpdate));
+X86_FUNC(GUEST(DSOUND_Internal_XMediaPacketUpdate)) {
+    if (!ctx.ecx) {
+        ::kernel::Return(ctx, 0x88780032u, 1);
+        return;
+    }
+    GUEST_ORIG(DSOUND_Internal_XMediaPacketUpdate)(ctx, base);
+}
