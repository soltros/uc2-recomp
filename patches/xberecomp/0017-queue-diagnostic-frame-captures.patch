diff --git a/sdk/runtime/gpu/backend.h b/sdk/runtime/gpu/backend.h
--- a/sdk/runtime/gpu/backend.h
+++ b/sdk/runtime/gpu/backend.h
@@ -64,4 +64,14 @@ inline std::atomic<uint64_t> g_perf_sync_late{0}, g_perf_sync_block{0};  // read
 // F3: save the next frame, every draw and target, under diag::CaptureDir
 inline std::atomic<bool> g_capture{false};
+// Scripted capture requests are queued (with a small cap) so signals received
+// during a lengthy frame dump are not collapsed into one boolean request.
+inline std::atomic<uint32_t> g_capture_requests{0};
+inline bool CaptureRequested() {
+    if (g_capture.exchange(false, std::memory_order_relaxed)) return true;
+    uint32_t pending = g_capture_requests.load(std::memory_order_relaxed);
+    while (pending && !g_capture_requests.compare_exchange_weak(
+                           pending, pending - 1, std::memory_order_relaxed)) {}
+    return pending != 0;
+}
 
 }  // namespace gpu
diff --git a/sdk/runtime/gpu/d3d12.cpp b/sdk/runtime/gpu/d3d12.cpp
--- a/sdk/runtime/gpu/d3d12.cpp
+++ b/sdk/runtime/gpu/d3d12.cpp
@@ -2965,7 +2965,7 @@ void D3D12Backend::Present(const Surface& front) {
     PerfScope perf_present{g_perf.present};
     if (cap_) {
         FinishCapture(front);
-    } else if (g_capture.exchange(false) && CaptureOn()) {
+    } else if (CaptureRequested() && CaptureOn()) {
         StartCapture();
     }
     ResizeSwap();
diff --git a/src/common/capture_signal.cpp b/src/common/capture_signal.cpp
--- a/src/common/capture_signal.cpp
+++ b/src/common/capture_signal.cpp
@@ -6,6 +6,10 @@ namespace game {
 
 namespace {
-void OnCaptureSignal(int) { gpu::g_capture = true; }
+void OnCaptureSignal(int) {
+    uint32_t pending = gpu::g_capture_requests.load(std::memory_order_relaxed);
+    while (pending < 4 && !gpu::g_capture_requests.compare_exchange_weak(pending, pending + 1,
+                                                                        std::memory_order_relaxed)) {}
+}
 }  // namespace
 
 void InstallCaptureSignal() { std::signal(SIGUSR1, OnCaptureSignal); }
