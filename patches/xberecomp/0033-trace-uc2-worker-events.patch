+static void TraceUC2WorkerEvent(const Object& o, const char* action, int32_t previous) {
+    if (o.guest != 0xB016F850 && o.guest != 0xB016F860) return;
+    static uint32_t samples[2]{};  // Set/reset callers hold g_dispatch.
+    uint32_t index = o.guest == 0xB016F850 ? 0 : 1;
+    uint32_t sample = samples[index]++;
+    if (sample < 16 || (sample % 64) == 0) {
+        LOGI("kernel: UC2 worker event %s guest=%08X previous=%d current=%d sample=%u",
+             action, o.guest, previous, o.signal, sample);
+        if (Thread* self = Current(); self && self->ctx) LogGuestStack(*self->ctx, 8);
+    }
+}
