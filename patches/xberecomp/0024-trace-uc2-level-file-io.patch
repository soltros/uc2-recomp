+void TraceUC2LevelTransfer(const File& f, bool write, uint64_t pos, uint32_t requested, uint32_t actual,
+                           uint32_t status) {
+    if (!TraceUC2LevelIo(f.xbox)) return;
+    static std::mutex lock;
+    static std::unordered_map<std::string, uint64_t> counts;
+    uint64_t sample;
+    {
+        std::lock_guard<std::mutex> guard(lock);
+        sample = counts[f.xbox]++;
+    }
+    if (sample < 32 || (sample % 256) == 0)
+        LOGI("files: UC2 level %s[%llu] %s offset=%llu requested=%u actual=%u status=%08X",
+             write ? "write" : "read", (unsigned long long)sample, f.xbox.c_str(), (unsigned long long)pos,
+             requested, actual, status);
+}
