+bool TraceUC2LevelIo(const std::string& path) {
+    static const bool enabled = [] {
+        const char* value = std::getenv("XBE_TRACE_LEVEL_IO");
+        return value && *value && *value != '0';
+    }();
+    return enabled && Upper(path).find("CTF-DOWNFALL") != std::string::npos;
+}
