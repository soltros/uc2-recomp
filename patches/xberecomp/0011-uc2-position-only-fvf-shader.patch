diff --git a/sdk/runtime/xdk/d3d8.cpp b/sdk/runtime/xdk/d3d8.cpp
--- a/sdk/runtime/xdk/d3d8.cpp
+++ b/sdk/runtime/xdk/d3d8.cpp
@@ -1096,10 +1096,21 @@ std::shared_ptr<gpu::VertexShader> SelectedShader(uint32_t handle, uint32_t slot) {
         } else if (g_state.vs) {
             source = g_state.vs.get();
         }
         if (source && !source->program.empty()) {
+            // UC2's screen-space FVF shader only writes oPos = v0. It relies on
+            // the fixed-function path to pass diffuse color and texture coords;
+            // treating this marker program as programmable leaves both zero and
+            // makes every menu draw black.
+            bool uc2_position_only = source->program.size() == 4 && source->program[0] == 0 &&
