+                                     source->program[3] == 0x2070F801;
+            if (uc2_position_only) {
+                LOG_FIRST(8, "d3d: UC2 position-only shader at slot %u; using fixed-function FVF outputs", slot);
+            } else {
-            vs.program = source->program;
-            LOG_FIRST(32, "d3d: shader slot %u had no loaded program; using %zu instructions from handle %08X", slot,
-                      vs.program.size() / 4, handle ? handle : g_state.vs_handle);
+                vs.program = source->program;
+                LOG_FIRST(32, "d3d: shader slot %u had no loaded program; using %zu instructions from handle %08X", slot,
+                          vs.program.size() / 4, handle ? handle : g_state.vs_handle);
+            }
         }
     }
     vs.program_type = kVertexProgramType;
